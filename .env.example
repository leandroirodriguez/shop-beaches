# Copy this file to `.env` and fill in the real values.
# Do NOT commit `.env` — it's in .gitignore.

# --- Supabase (browser-safe, publishable key) ---
# Found at: Supabase Dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Server-only (used by /api functions on Vercel; never exposed to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Anthropic (Claude API for AI generation) ---
# console.anthropic.com → Settings → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...

# --- Amazon Associates ---
# Your tracking ID. Found at affiliate-program.amazon.com →
# Account Settings → Manage Your Tracking IDs.
AMAZON_PARTNER_TAG=beachesobgyn-20

# --- Amazon Creators API (auto-fetch product details by URL) ---
# Generate at affiliate-program.amazon.com/creatorsapi → Manage Credentials.
# The labels Amazon's UI uses are exactly: "Credential ID", "Secret", "Version".
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=3.1
# Optional — defaults to www.amazon.com (US marketplace)
# AMAZON_MARKETPLACE=www.amazon.com
