# Copy this file to `.env` and fill in the real values.
# Do NOT commit `.env` — it's in .gitignore.

# --- Supabase (browser-safe, anon key) ---
# Found at: Supabase Dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Server-only (used by /api functions on Vercel; never exposed to the browser) ---
# Same Settings → API page; this one has elevated privileges. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Anthropic (Claude API for AI generation) ---
# console.anthropic.com → Settings → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...

# --- Amazon Product Advertising API (PA-API 5.0) ---
# affiliate-program.amazon.com → Tools → Product Advertising API → Manage Credentials
AMAZON_ACCESS_KEY=AKIAxxxx...
AMAZON_SECRET_KEY=xxxxxxxx
AMAZON_PARTNER_TAG=beachesobgyn-20
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1
