# Copy this file to `.env` and fill in the real values.
# Do NOT commit `.env` — it's in .gitignore.

# --- Supabase (browser-safe, publishable key) ---
# Found at: Supabase Dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Server-only (used by /api functions on Vercel; never exposed to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Anthropic (Claude API for AI generation) ---
# console.anthropic.com → Settings → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...

# --- Amazon Associates ---
# Your tracking ID. Found at affiliate-program.amazon.com →
# Account Settings → Manage Your Tracking IDs. Used to build affiliate URLs.
# (No API calls right now — admin uses manual paste.
#  PA-API retires 2026-05-15; Creators API integration is a TODO.)
AMAZON_PARTNER_TAG=beachesobgyn-20
